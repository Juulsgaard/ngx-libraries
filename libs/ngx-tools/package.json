{
  "name": "@juulsgaard/ngx-tools",
  "description": "Basic utilities for working with Angular",
  "repository": "git@github.com:Juulsgaard/ngx-libraries.git",
  "homepage": "https://github.com/Juulsgaard/ngx-libraries/tree/main/libs/ngx-tools",
  "version": "21.0.0",
  "main": "src/index.ts",
  "publishConfig": {
    "directory": "../../dist/libs/ngx-tools"
  },
  "peerDependencies": {
    "@angular/animations": "catalog:",
    "@angular/common": "catalog:",
    "@angular/core": "catalog:",
    "@angular/router": "catalog:",
    "@angular/cdk": "catalog:",
    "@juulsgaard/signal-tools": "^21.0.0",
    "@juulsgaard/rxjs-tools": "~1.9.0",
    "@juulsgaard/ts-tools": "~1.8.0",
    "rxjs": "^7.8.2"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/platform-browser": "catalog:"
  },
  "exports": {
    ".": {
      "sass": "./styles/index.scss"
    },
    "./theme": {
      "sass": "./theme/index.scss"
    },
    "./theme/light-theme": {
      "sass": "./theme/light-theme.scss"
    },
    "./theme/dark-theme": {
      "sass": "./theme/dark-theme.scss"
