{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "libsDir": "libs"
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*"
    ]
  },
  "release": {
    "projectsRelationship": "independent",
    "changelog": {
      "projectChangelogs": true,
      "workspaceChangelog": false
    }
  },
  "nxCloudId": "6735de08f1704f56307506c1",
  "targetDefaults": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "libs/{projectName}"
      },
      "dependsOn": [
        "build"
      ]
    },
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ]
    }
  },
  "generators": {
    "@nx/angular:library": {
      "style": "scss",
      "buildable": true,
      "publishable": true,
      "prefix": "ngx"
    },
    "@nx/angular:component": {
      "style": "scss"
    }
  },
  "analytics": false
}
