{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "declaration": false,
    "noImplicitAny": true,
    "stripInternal": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "importHelpers": true,
    "sourceMap": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "outDir": "./dist/out-tsc",
    "paths": {
      "@juulsgaard/ngx-forms": ["libs/ngx-forms/src/index.ts"],
      "@juulsgaard/ngx-forms-inputs": ["libs/ngx-forms-inputs/src/index.ts"],
      "@juulsgaard/ngx-service-worker": ["libs/ngx-service-worker/src/index.ts"],
      "@juulsgaard/ngx-tools": ["libs/ngx-tools/src/index.ts"],
      "@juulsgaard/ngx-ui": ["libs/ngx-ui/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": ["node_modules", "tmp"]
}
